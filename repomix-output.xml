    return {
      'cashLoanBalance': newCashBal,
      'installmentDueBalance': currentInstallmentDue,
      'grandNetTotal': newNetTotal,
      'updatedAt': nowIso,
      'lastUpdated': nowIso,
      'isSynced': false,
    };
  }
}
