import 'package:flutter/foundation.dart';
import '../../hive_services/hive_box_manager.dart';
class PaymentConfigService {
  static const List<String> defaultSources = [
    'Cash',
    'JazzCash',
    'EasyPaisa',
  ];
  static const List<Map<String, dynamic>> defaultAdjustments = [
    {'name': 'خاص رعایت', 'isIncome': false},
    {'name': 'عام رعایت', 'isIncome': false},
  ];
  static Future<List<String>> getPaymentSources() async {
    try {
      final box = await HiveBoxManager.openSafeBox(HiveBoxManager.appConfigBoxName);
      final dynamic doc = box.get('banks_config');
      if (doc != null) {
        dynamic rawData;
        if (doc is Map) {
          rawData = doc['availableBanks'] ?? doc['banks'];
        }
        List<String> extracted = [];
        if (rawData is Map) {
          extracted = rawData.keys
              .map((k) => k.toString().trim())
              .where((s) => s.isNotEmpty)
              .toList();
        }
        else if (rawData is List) {
          extracted = rawData
              .map((e) => (e is Map ? (e['name'] ?? e['title'] ?? '') : e).toString().trim())
              .where((s) => s.isNotEmpty)
              .toList();
        }
        if (extracted.isNotEmpty) {
          // اگر لسٹ میں کیش موجود ہو تو اسے پہلے نمبر پر لائیں تاکہ بائی ڈیفالٹ کیش منتخب ہو
          final cashIndex = extracted.indexWhere((item) =>
              item.toLowerCase() == 'cash' ||
              item.contains('کیش') ||
              item.toLowerCase().contains('cash'));
          if (cashIndex > 0) {
            final cashItem = extracted.removeAt(cashIndex);
            extracted.insert(0, cashItem);
          }
          return extracted;
        }
      }
    } catch (e) {
      debugPrint('❌ getPaymentSources Error: $e');
    }
    return defaultSources;
  }
  static Future<List<Map<String, dynamic>>> getAdjustmentCategories() async {
    try {
      final box = await HiveBoxManager.openSafeBox(HiveBoxManager.appConfigBoxName);
      final dynamic doc = box.get('discounts_config');
      if (doc != null) {
        dynamic rawData;
        if (doc is Map) {
          rawData = doc['discountCategories'] ?? doc['discounts'];
        }
        List<Map<String, dynamic>> extracted = [];
        if (rawData is Map) {
          extracted = rawData.keys.map((k) {
            final name = k.toString().trim();
            final bool isInc = name.contains('اضافی') || name.contains('فیس') || name.contains('انکم');
            return {
              'name': name,
              'isIncome': isInc,
            };
          }).where((m) => (m['name'] as String).isNotEmpty).toList();
        } else if (rawData is List) {
          extracted = rawData.map((e) {
            if (e is Map) {
              return {
                'name': (e['name'] ?? e['title'] ?? 'رعایت').toString(),
                'isIncome': e['isIncome'] == true,
              };
            }
            final name = e.toString().trim();
            final bool isInc = name.contains('اضافی') || name.contains('فیس') || name.contains('انکم');
            return {
              'name': name,
              'isIncome': isInc,
            };
          }).where((m) => (m['name'] as String).isNotEmpty).toList();
        }
        if (extracted.isNotEmpty) {
          return extracted;
        }
      }
    } catch (e) {
      debugPrint('❌ getAdjustmentCategories Error: $e');
    }
    return defaultAdjustments;
  }
}
