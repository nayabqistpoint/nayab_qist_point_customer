      'imeiNo': imeiNo,
      'warranty': warranty,
      'generalSpecs': generalSpecs,
      'purchasePrice': purchasePrice,
      'salePrice': salePrice,
      'quantity': 1,
      'status': isPromotionalOnOrder ? 'available_on_order' : 'available',
      'customerPhone': customerPhone,
      'supplier': 'nayab_point',
      'images': images.join(','),
      'createdAt': nowIso,
      'updatedAt': nowIso,
      'isSynced': false,
    };
  }
}
