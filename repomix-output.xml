                    months: months,
                    advance: advance,
                    monthly: monthly,
                    totalInstallmentSum: totalInstallmentSum,
                  ),
                  const SizedBox(height: 12),
                  ReceiptScheduleTableUi(installmentSchedule: widget.installmentSchedule),
                  const SizedBox(height: 12),
                  if (isChequePlan) ...[
