class PaymentPayloadService {
  static Map<String, dynamic> buildPayload({
    required String title,
    required String? itemName,
    required String? planTitle,
    required int? installmentNo,
    required int targetPayable,
    required int paidAmount,
    required int adjustmentVal,
    required bool isIncome,
    required List<Map<String, dynamic>> splits,
    required String note,
    required String receiptImagePath,
    required String voiceNotePath,
    required bool isInstallment,
  }) {
    return {
      'title': title,
      'itemName': itemName ?? (isInstallment ? 'موبائل فون' : 'نقد ادھار کھاتہ'),
      'planTitle': planTitle ?? '',
      'installmentNo': installmentNo,
      'resolved': targetPayable,
      'paid': paidAmount,
      'discount': isIncome ? 0 : adjustmentVal,
      'extra': isIncome ? adjustmentVal : 0,
      'splits': List<Map<String, dynamic>>.from(splits),
      'note': note.trim(),
      'receiptImagePath': receiptImagePath,
      'voiceNotePath': voiceNotePath,
      'hasPhoto': receiptImagePath.isNotEmpty,
      'hasAudio': voiceNotePath.isNotEmpty,
      'isInstallment': isInstallment,
      'paymentDate': DateTime.now().toIso8601String(),
      'verificationStatus': 'UNDER_REVIEW',
      'syncStatus': 'LOCAL_HIVE',
    };
  }
}
