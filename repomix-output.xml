}
class _ServiceStockEntryPageState extends State<ServiceStockEntryPage> {
  ServiceStockController? _controller;
  @override
  void initState() {
    super.initState();
    _controller = ServiceStockController(targetAccounts: widget.targetAccounts);
  }
  @override
  void dispose() {
    _controller?.dispose();
    super.dispose();
