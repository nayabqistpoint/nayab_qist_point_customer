    final int newNetTotal = newCashBal + currentInstallmentDue;
    final nowIso = DateTime.now().toIso8601String();
    return {
      'cashLoanBalance': newCashBal,
      'installmentDueBalance': currentInstallmentDue,
      'grandNetTotal': newNetTotal,
      'updatedAt': nowIso,
      'lastUpdated': nowIso,
      'isSynced': false,
    };
  }
}
